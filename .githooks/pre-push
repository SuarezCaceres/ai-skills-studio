#!/usr/bin/env bash
# Bloquea el push directo a main/master. Los cambios llegan a main solo por PR.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "✘ Push directo a ${remote_ref#refs/heads/} bloqueado. Trabaja en una rama y abre un PR."
      exit 1
      ;;
  esac
done
exit 0
